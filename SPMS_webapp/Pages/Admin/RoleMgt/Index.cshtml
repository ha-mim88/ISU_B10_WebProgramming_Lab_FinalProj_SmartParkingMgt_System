@page
@model SPMS_webapp.Pages.Admin.RoleMgt.IndexModel

@{
    ViewData["Title"] = "Role Mgt";
}

@* <h1>Index</h1> *@

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationRole[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationRole[0].NormalizedName)
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ApplicationRole) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NormalizedName)
            </td>
            @* <td>
                <a asp-page="./RoleMenuPermission/Index" asp-route-RoleId="@item.Id">Menu Permission</a>
            </td> *@
            <td>
                @if (item.Name.ToUpper() != "ADMIN")
                {
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                } else
                {
                    <span>Can't Delete Admin Role</span>
                }
            </td>
        </tr>
}
    </tbody>
</table>
