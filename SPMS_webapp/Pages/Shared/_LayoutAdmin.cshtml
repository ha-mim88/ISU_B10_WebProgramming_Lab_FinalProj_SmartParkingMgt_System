<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SPMS_webapp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SPMS_webapp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row min-vh-100">
            <aside class="col-12 col-sm-4 col-md-3 col-lg-2 p-3" style="background-color: #e9f2ff;">
                <a class="navbar-brand d-block mb-3" asp-area="" asp-page="/Index">SPMS_webapp</a>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/admin/usermgt/index">User Mgt</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/admin/rolemgt/index">Role Mgt</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/admin/parkingmetermgt/index">Meter Setup</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/admin/parkingspotmgt/index">Parking Spot Setup</a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </aside>
            <div class="col p-0 d-flex flex-column">
                <main role="main" class="container py-3 flex-grow-1">
                    @RenderBody()
                </main>

                <footer class="border-top footer text-muted">
                    <div class="container">
                        &copy; 2026 - SPMS_webapp - <a asp-area="" asp-page="/Privacy">Privacy</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
