@page
@using System.Security.Claims
@using SPMS_webapp.Service
@model SPMS_webapp.Pages.Drivers.IndexModel
@inject IParkingSpotBookingService _ps
@{
    var parkingspots = _ps.GetAllParkingSpots();
    var hasActiveParking = _ps.HasActiveParking(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var activeSpotId = _ps.GetActiveParkingSpotId(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var activeParkingHistory = _ps.GetActiveParkingHistory(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var userparkinghistory = _ps.GetActiveParkingHistories(User.FindFirstValue(ClaimTypes.NameIdentifier));
}

<h1>Welcome to Driver Dashboard</h1>

<div>
    @if (TempData["SuccessMessage"] != null )
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if(TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    
</div>
<div class="row">
    <div class="col-md-8 ">
        <div class="d-flex">
            @foreach (var spot in parkingspots)
            {
                <div class="card mb-3 @(spot.IsOccupied ? "border border-danger border-4" : "")">
                    <div class="card-body text-center">
                        <h5 class="card-title">
                            Parking Spot: @spot.SpotNumber - @spot.IOTEnabledParkingMeter.Code
                            @if (spot.IsOccupied)
                            {
                                <span class="badge bg-danger">Occupied</span>
                                <img width="100" class="d-block img img-thumbnail mx-auto" src="/upload/car dummy.png" />
                                
                                @if (activeSpotId == spot.Id)
                                {
                                    var duration_min = ((activeParkingHistory.ParkingEnd ?? DateTime.Now) - activeParkingHistory.ParkingStart).TotalMinutes;
                                    <div class="alert alert-info">
                                        <string>@duration_min.ToString("0.00")</string> minutes @(!activeParkingHistory.IsCheckedOut ? " and ongoing..." : "")
                                    </div>
                                    @if(!activeParkingHistory.IsCheckedOut){
                                        <div class="alert alert-success">
                                            Total Parking Fee (so far): <strong>Tk. @((duration_min * 2).ToString("0.00"))</strong>
                                        </div>
                                    }
                                    // add a js refresh button to refresh the page every 30 seconds to update the parking duration and fee

                                    <div class="mb-2">
                                        <button type="button" class="btn btn-sm btn-primary" onclick="location.reload();">
                                            <i class="bi bi-arrow-clockwise"></i> Refresh Now
                                        </button>
                                        <div class="small text-muted ms-2">Auto-refreshing every 30 seconds</div>
                                    </div>
                                    <script>
                                        // Auto-refresh every 30 seconds
                                        setInterval(function() {
                                            location.reload();
                                        }, 30000);
                                    </script>

                                    <div class="mt-2">
                                        <form method="post" asp-page-handler="CheckOut" asp-route-SpotId="@spot.Id" asp-route-ParkingHistoryId="@activeParkingHistory.Id">
                                            <input type="submit" value="Pay & Check Out" class="btn btn-danger" />
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success">Available</span>
                            }                            
                        </h5>
                        <div>
                            @if (!spot.IsOccupied && !hasActiveParking)
                            {                                
                                <form method="post" asp-page-handler="ParkNow" asp-route-SpotId="@spot.Id">
                                    <input type="submit" value="Park Now" class="btn btn-success" />
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
        <div class="list-group">
            <div class="list-group-item list-group-item-success">
                <h5 class="mb-1">Previous Parking History</h5>
            </div>
            @foreach (var history in userparkinghistory.OrderByDescending(a=>a.ParkingEnd))
            {
                <div class="list-group-item d-flex">
                    <p class="mb-1 fw-bold">@history.ParkingStart.ToString("yyyy-MM-dd HH:mm:ss tt") - @history.ParkingEnd.Value.ToString("yyyy-MM-dd HH:mm:ss tt")</p>
                    <p class="mb-1 ps-3">Paid Amount: Tk. @history.TotalBill.ToString("0.00")</p>
                </div>
            }
        </div>
    </div>
    <div class="col-md-4">
        <div>
            @if (Model.MyDriverProfile != null)
            {
                <div class="alert alert-success">
                    <p>Your driver profile exists. You can update it below.</p>
                </div>
                <h4>Update Driver Profile</h4>
            }
            else
            {
                <div class="alert alert-warning">
                    <p>No driver profile found. Please create your profile.</p>
                </div>
                <h4>Create Driver Profile</h4>
            }

            <form method="post" class="mt-3">
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.DriverLicenseNo" class="form-label"></label>
                    <input asp-for="Input.DriverLicenseNo" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.VehicleNo" class="form-label"></label>
                    <input asp-for="Input.VehicleNo" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ContactNo" class="form-label"></label>
                    <input asp-for="Input.ContactNo" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">
                    @(Model.MyDriverProfile != null ? "Update Profile" : "Create Profile")
                </button>
            </form>
        </div>
    </div>
</div>
